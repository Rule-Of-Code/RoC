# Environment variables RuleOfCode reads. None is required and none holds a
# secret: every one has a default, and the values here are left empty on
# purpose. Copy to .env only if you want to set one locally (.env is ignored).

# Logging (src/utils/logging-utils.ts): any value but "production" lets the
# internal warn/error/info logs print; with it, they are silent.
NODE_ENV=

# With NODE_ENV not "production", any non-empty value also prints debug logs.
DEBUG=

# Configuration overrides (src/config/loader.ts): a variable starting with
# ROC_ or RULEOFCODE_ sets one configuration key. The prefix is dropped, the
# rest is lower-cased and "_" becomes "." — ROC_REPORTING_VERBOSE=true sets
# reporting.verbose to true. "true"/"false" and numbers are parsed.
# ROC_REPORTING_VERBOSE=

# Set by the CI system, never by hand: CI, GITHUB_ACTIONS, GITHUB_HEAD_REF,
# GITHUB_REF_NAME, GITLAB_CI, CI_COMMIT_BRANCH,
# CI_MERGE_REQUEST_SOURCE_BRANCH_NAME, BITBUCKET_BUILD_NUMBER, BITBUCKET_BRANCH,
# CIRCLECI, CIRCLE_BRANCH, TRAVIS, BUILDKITE, JENKINS_URL, BUILD_TAG,
# BRANCH_NAME, GIT_BRANCH, TF_BUILD, TEAMCITY_VERSION, CODEBUILD_BUILD_ID.
# They tell RuleOfCode it runs on CI and which branch is being built.
